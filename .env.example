# Copy to .env and fill in. .env is gitignored.

# Public hostname visitors use. Requests with any other Host header get 403.
LEGO_DOMAIN=mosaic.example.com

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token.
# Only needed for:  docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Jobs processed at the same time. One per CPU core you want to give it.
LEGO_WORKER_COUNT=2

# Per-visitor cap on new jobs. 0 disables.
LEGO_UPLOADS_PER_MINUTE=5
